# Backend Environment Variables
# Copy this file to .env and fill in your values

# MongoDB
MONGO_USER=your_mongo_user
MONGO_PASSWORD=your_mongo_password
MONGO_HOST=cluster0.xxxxx.mongodb.net
MONGO_DB_NAME=Studiesmasters

# JWT
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=noreply@yourdomain.com

# Payments (Paystack)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx

# Server
PORT=5000
LOG_LEVEL=info

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Web Push Notifications (VAPID keys)
# Generate with: node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Moodle LMS — enterprise SSO + account management
# ---------------------------------------------------
# Required for the SSO handshake (share with the Moodle plugin):
MOODLE_SSO_SECRET=your_shared_moodle_sso_secret_min_32_chars
MOODLE_BASE_URL=https://lms.studiesmasters.com
MOODLE_SSO_PATH=/local/studiesmasters_sso/sso.php

# One-time login token lifetime (ms). Nonces auto-expire after this.
MOODLE_SSO_LIFETIME_MS=300000
# Clock-skew tolerance (seconds) allowed on timestamps.
MOODLE_SSO_CLOCK_SKEW=300

# Redis for the nonce store (optional; falls back to MongoDB TTL when unset).
REDIS_URL=

# Moodle REST Web Services — used by the backend to create/update/enroll/suspend
# accounts. Set MOODLE_WS_ENABLED=true and paste an admin WS token to go live.
# Leave false and MOODLE_DRY_RUN=true (default) to run fully offline.
MOODLE_WS_ENABLED=false
MOODLE_WS_URL=
MOODLE_WS_TOKEN=
MOODLE_DRY_RUN=true
MOODLE_WS_TIMEOUT_MS=10000
MOODLE_WS_RETRIES=3
MOODLE_WS_RETRY_BACKOFF_MS=1000

# Automatic profile/enrollment sync (enqueue a job when a student changes).
MOODLE_AUTO_SYNC=false
# Durable job queue worker.
MOODLE_WORKER_ENABLED=false
# Periodic MongoDB <-> Moodle reconciliation.
MOODLE_RECONCILIATION_ENABLED=false
MOODLE_RECONCILIATION_INTERVAL_MS=3600000
MOODLE_RECONCILIATION_ON_START=false

# Package -> subjects mapping (packages never create courses; they only pick
# which provisioned courses a student is enrolled in).
MOODLE_PACKAGE_MAP_JSON={"Starter":["Mathematics"],"Standard":["Mathematics","Science"],"Premium":["Mathematics","Science","English"]}

# Secret rotation (optional). Array of {id, secret} to VERIFY with (primary =
# MOODLE_SSO_SECRET). Rotate by adding a new secret to this list + MOODLE_SSO_ACTIVE_ID.
MOODLE_SSO_ACTIVE_ID=1
MOODLE_SSO_SECRETS=[]

# Audit trail to MongoDB (MoodleAuditLog collection).
MOODLE_AUDIT_DB=true
